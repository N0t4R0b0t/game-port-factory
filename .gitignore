# build artifacts
gpf/target/

# Original media and anything derived from it never goes in git.
# Keep dumps local; keep converted assets local.
ports/*/source/
ports/*/extracted/
# Decompiled scripts (int2ssl output) are derived from the user's own game
# install too, same as the above — never commit them, regenerate locally.
ports/*/target/*.ssl
# Recorded playthroughs: demo artifacts, not verification references (unlike
# the committed reference-*.png screenshots, these aren't byte-diffed) and
# not small — regenerate with target/record.sh rather than version them.
ports/*/target/recordings/

# Python bytecode from the tools/ helper scripts
__pycache__/
*.pyc

# --- Never commit: proprietary game data, or anything derived from it ---
# Original publisher source, game images and extracted data stay local. A
# clone therefore cannot build the ports without the user's own dumps --
# that is deliberate. ports/dizzy-coco2/tools/regen_art.sh documents how
# to regenerate the converted art once FRAMES.DAT is present locally.
ports/*/research/**/original_source/
ports/*/research/**/info/
*.tap
*.tzx
*.sna
*.z80
*.d64
*.dsk

# Converted assets (contain the original games' art/level bytes verbatim)
ports/dizzy-coco2/target/*_data.asm
ports/dizzy-coco2/target/dizzy_frame*.asm

# T0225: DTE text compression -- generated (fcc rewritten to fcb byte
# lists) from ports/dizzy-coco2/target/text_src/*.asm, by tools/dte.
# Regenerated by tools/stage_pack.sh; never hand-edit these.
ports/dizzy-coco2/target/gap_messages.asm
ports/dizzy-coco2/target/gameplay.asm
ports/dizzy-coco2/target/actors.asm
ports/dizzy-coco2/target/ui_room_names.asm
ports/dizzy-coco2/target/rat_troll_hazard_code.asm
ports/dizzy-coco2/target/dte_table.asm
ports/dizzy-coco2/target/msg_data_tape.asm
ports/dizzy-coco2/target/msg_data_tape_low.asm
ports/dizzy-coco2/target/msg_data_tape_low3.asm
ports/dizzy-coco2/target/msg_data_tape_low4.asm

# Build outputs
ports/*/target/*.bin
# T0241: floppy build outputs; the MAME FDC rompath holds a COPY of the user's DSKBASIC.ROM
ports/*/target/*.dsk
ports/*/target/mamerom/
ports/*/target/floppy/
ports/*/target/*.rom
ports/*/target/*.prg
ports/*/target/*.cas
ports/*/target/hostdir/
ports/*/tools/*/target/

# T0231 playthrough bot: MAME save states (machine-specific, large) and the regenerable static room masks
ports/*/target/pt_states/
ports/*/target/pt_states_floppy/
ports/*/target/pt_tmp/
ports/*/target/pt_masks/
ports/*/target/*.mp4
ports/*/target/zxpt_states/
# T0255 tools/roomcmp.sh: per-room actor traces recorded from the user's own ZX tape (derived data)
ports/*/target/roomcmp/
ports/*/target/*.plan.tsv

# Public-release guard: converted game data and music/SFX captures are never ADDED by
# `git add -A` here. Files already tracked stay tracked (private archive); force-add
# (`git add -f`) a new one deliberately if you want it in the private repo. The public
# export (scripts/export-public.sh + .public-exclude) drops them regardless.
ports/*/target/*_data_tape.asm
ports/*/target/staged_*.asm
ports/*/target/title_*.asm
ports/*/target/win_mix3*.asm
ports/*/target/text_src/
ports/*/target/text_src_tape/
ports/*/tools/aycapture/captures/
ports/*/wip/
ports/*/harness/probes/
*.cas
*.wav
dist/

# tools/bootstrap.sh step logs
ports/*/target/bootstrap_logs/

# ---- Dizzy CoCo2 bootstrap outputs (tools/bootstrap.sh; list kept in step with
# ports/dizzy-coco2/tools/clean_generated.sh). Generated from the user's own inputs; never committed.
ports/dizzy-coco2/extracted/
ports/dizzy-coco2/target/dizzy_frames_all.asm
ports/dizzy-coco2/target/dizzy_frames_body*.asm
ports/dizzy-coco2/target/dizzy_frames_tail.asm
ports/dizzy-coco2/target/sound_data.asm
ports/dizzy-coco2/tools/aycapture/captures/
ports/dizzy-coco2/target/room[0-9]*_data*.asm
ports/dizzy-coco2/target/font_data.asm
ports/dizzy-coco2/target/frame_table_data*.asm
ports/dizzy-coco2/target/floppy_clip_*.asm
ports/dizzy-coco2/target/actor_data*.asm
ports/dizzy-coco2/target/coin_data*.asm
ports/dizzy-coco2/target/shared_*_data.asm
ports/dizzy-coco2/target/msg_data_*.asm
ports/dizzy-coco2/target/staged_*_lz*.asm
ports/dizzy-coco2/target/staged_syms*.asm
ports/dizzy-coco2/target/staged_[cd]_raw*.bin
ports/dizzy-coco2/target/image_end_lz*.asm
ports/dizzy-coco2/target/title_frags*.asm
ports/dizzy-coco2/target/title_lz*.asm
ports/dizzy-coco2/target/title_resident_*.asm
ports/dizzy-coco2/target/win_mix3_lz*.asm
ports/dizzy-coco2/target/win_mix3_syms*.asm
ports/dizzy-coco2/target/room36*.map
ports/dizzy-coco2/target/text_src/
ports/dizzy-coco2/target/text_src_tape/
# The original's strings as a Lua table for the harnesses (textsplit export-lua); your text, never committed
ports/dizzy-coco2/harness/orig_text.lua

# Hand-authored files whose names match the generated-file patterns above
!ports/dizzy-coco2/target/title_mix3.asm
!ports/dizzy-coco2/target/win_mix3.asm
